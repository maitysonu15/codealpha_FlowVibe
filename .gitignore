# ==============================================================================
# FlowVibe .gitignore
# Security & Privacy: Exclude environment variables, secrets, databases & caches
# ==============================================================================

# Environment files and API credentials
.env
.env.*
!.env.example
*.env
teamflow/backend/.env

# SQLite and Local Databases
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Django local files
local_settings.py
media/
staticfiles/
*.log

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
